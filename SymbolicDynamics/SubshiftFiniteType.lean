-- 1.48.b
-- Let 𝔸 ⊆ (Ω → A) be a set of "admissible patterns"
-- This is the set X(𝔸) = {x | ∀ t, (shift t x)|Ω ∈ 𝔸}
def subshift_from_admissible_patterns {T A: Type*} [Mul T] {Ω: Set T} (𝔸: Set (Ω → A)): Set (T → A) :=
  {x | ∀ t, Ω.restrict (shift t x) ∈ 𝔸}

-- Suppose A and Ω are finite. Then X(𝔸) is a subshift of finite type.
theorem subshift_from_admissible_patterns_finite_type {T A: Type*} [TopologicalSpace A] [Finite A] [Mul T] {Ω: Set T} [Finite Ω] (𝔸: Set (Ω → A)):
  Subshift_of_finite_type (subshift_from_admissible_patterns 𝔸) := by
  exists {⟨Ω, f⟩ | f ∈ Set.compl 𝔸}
  constructor
  . let φ: {b: Block T A | ∃ f ∈ 𝔸.compl, ⟨Ω, f⟩ = b} → (Ω → A) := fun ⟨⟨_, f⟩, hb⟩ x => by
      rw [←(Sigma.mk.inj_iff.mp (Classical.choose_spec hb).right).left] at f
      exact f x
    apply Finite.of_injective φ
    intro x1 x2 hx
    simp [φ] at hx
    obtain ⟨_, hx1⟩ := x1
    obtain ⟨_, hx2⟩ := x2
    obtain ⟨_, hf1⟩ := hx1
    obtain ⟨_, hf2⟩ := hx2
    obtain ⟨_, hf1b⟩ := hf1
    obtain ⟨_, hf2b⟩ := hf2
    subst hf2b hf1b
    simp_all [cast_eq]
  . simp [subshift_from_admissible_patterns, shift_from_forbidden_blocks, appears_anywhere, appears]
    ext x
    constructor
    . intro h p hp t
      apply Not.intro
      intro h1
      rw [←h1] at hp
      specialize h t
      contradiction
    . intro h t
      by_contra h'
      specialize h (Ω.restrict (shift t x)) h' t
      exact h rfl

-- 1.48.e
theorem subshift_of_finite_type_univ [Mul X] [TopologicalSpace Y]:
  Subshift_of_finite_type (@Set.univ (X → Y)) := by
  exists ∅
  constructor
  exact Set.finite_empty
  simp [shift_from_forbidden_blocks]

-- 1.48.f
-- intersection of subshfits of finite type is a subshift with finite type
theorem subshift_of_finite_type_inter [Mul X] [TopologicalSpace Y]
  {Λ1 Λ2: Set (X → Y)} (h1: Subshift_of_finite_type Λ1) (h2: Subshift_of_finite_type Λ2):
  Subshift_of_finite_type (Λ1 ∩ Λ2) := by
  obtain ⟨F1, hF1⟩ := h1
  obtain ⟨F2, hF2⟩ := h2
  exists F1 ∪ F2
  constructor
  exact @Finite.Set.finite_union _ F1 F2 hF1.left hF2.left
  rw [hF1.right, hF2.right]
  ext
  constructor
  intro ⟨hu1, hu2⟩ b h
  cases h
  case inl h' => exact hu1 b h'
  case inr h' => exact hu2 b h'
  intro h
  constructor
  · exact fun b hb => h b (Or.inl hb)
  · exact fun b hb => h b (Or.inr hb)

